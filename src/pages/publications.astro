---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PubEntry from '../components/PubEntry.astro';
import { site } from '../data/site';

const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const featured = pubs.filter((p) => p.data.featured);
const rest = pubs.filter((p) => !p.data.featured);
const tags = ['All', ...Array.from(new Set(pubs.flatMap((p) => p.data.tags))).sort()];
---
<Base title="Publications" description="Eight peer-reviewed papers, three as co-first author, including two in Nature Energy.">
  <div class="mx-auto max-w-[1140px] px-7 pb-24">
    <header class="flex flex-col gap-4 pt-14 pb-8">
      <span class="mono-label">Publications</span>
      <h1 class="max-w-[24ch] text-[clamp(32px,4.6vw,44px)] tracking-[-0.02em]">
        Eight papers, three as co-first author
      </h1>
      <p class="max-w-[74ch] text-[17px] text-ink-2">
        The three featured below are the co-first-author papers, and they happen to span the three
        research thrusts — green processing, phase stability, and scalable modules. Author name is
        given as <span class="font-mono text-[15px]">{site.name}</span> throughout; some published
        versions hyphenate it.
      </p>
      {site.links.scholar && (
        <a class="link w-fit text-[15px]" href={site.links.scholar} rel="noopener" target="_blank">Google Scholar profile</a>
      )}
    </header>

    <section class="pt-2">
      <h2 class="mono-label">Featured</h2>
      {featured.map((p) => <PubEntry pub={p.data} variant="featured" />)}
    </section>

    <section class="pt-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4 pb-2">
        <h2 class="mono-label">All publications — citation list</h2>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter publications by tag">
          {tags.map((t, i) => (
            <button
              type="button"
              class="chip pub-filter cursor-pointer transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent-wash aria-pressed:text-accent"
              data-filter={t}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {t}
            </button>
          ))}
        </div>
      </div>
      <div id="pub-list">
        {pubs.map((p) => <PubEntry pub={p.data} />)}
      </div>
      <p id="pub-empty" hidden class="border-t border-line py-8 text-[15px] text-muted">
        No publications carry that tag.
      </p>
    </section>

    <section class="mt-16 border-t border-line-strong pt-8">
      <h2 class="mono-label">Patent</h2>
      <div class="flex flex-col gap-2 pt-4">
        <h3 class="max-w-[70ch] text-[19px]">
          Sheet set for manufacturing perovskite solar cell modules, manufacturing method using the
          same, and perovskite solar cell module
        </h3>
        <p class="font-mono text-[13px] text-muted">
          <span class="text-signal">KR 10-2118728 B1</span> · registered 28 May 2020 · inventors:
          Sang Il Seok, <span class="font-semibold text-ink">Hyoungwoo Kwon</span>
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  // Client-side tag filter. No routing, no URL state — the list is short.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.pub-filter'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('#pub-list [data-tags]'));
  const empty = document.getElementById('pub-empty');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.filter ?? 'All';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((item) => {
        const tags = (item.dataset.tags ?? '').split('|');
        const match = tag === 'All' || tags.includes(tag);
        item.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
