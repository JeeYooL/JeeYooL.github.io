---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryScroll from '../components/StoryScroll.astro';
import { t, type Lang } from '../i18n/ui';
import { localePath, splitId } from '../i18n/utils';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);

const thrusts = (await getCollection('thrusts'))
  .filter((e) => splitId(e.id).lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects'))
  .filter((e) => splitId(e.id).lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const featured = (await getCollection('publications'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base lang={lang} title={s.home.title} description={s.home.description} scrollNav={true}>
  <div id="scroll-progress" class="fixed left-0 top-0 z-40 h-[2px] w-0 bg-accent" aria-hidden="true"></div>

  <!-- Dark opening chapter: the hero and the degradation story share one ground,
       then the page turns back to the reading theme. -->
  <section class="relative bg-[#0B100F] text-[#E9EEEC]">
    <div class="mx-auto flex max-w-[1140px] flex-col gap-14 px-7 pt-20 pb-16 md:pt-28 md:pb-20">
     <div class="grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-16">
      <div class="flex flex-col gap-6">
        <span class="hero-in mono-label text-[#63D2C3]" style="--i:0">{s.affiliation}</span>
        <h1 class="hero-in max-w-[17ch] text-[clamp(38px,7vw,72px)] leading-[1.06] tracking-[-0.03em] text-[#F3F7F5]" style="--i:1">
          {s.tagline}
        </h1>
        <p class="hero-in max-w-[56ch] text-[clamp(16px,1.5vw,19px)] leading-relaxed text-[#A7B5B1]" style="--i:2">
          {s.intro}
        </p>
        <div class="hero-in flex flex-wrap gap-2 pt-2" style="--i:3">
          <a
            href={localePath('/projects/', lang)}
            class="rounded-[4px] bg-[#63D2C3] px-5 py-2.5 text-[14px] font-medium text-[#0B100F] no-underline transition-colors hover:bg-[#8FE4D8]"
            >{s.common.seeProjects}</a
          >
          <a
            href="#story"
            class="rounded-[4px] border border-[#3A4B47] px-5 py-2.5 text-[14px] text-[#D6DEDB] no-underline transition-colors hover:border-[#63D2C3] hover:text-[#63D2C3]"
            >{s.home.story.heading}</a
          >
        </div>
      </div>

      <!-- Structural index: what the site is made of, before you scroll into it -->
      <nav class="hero-in flex flex-col justify-end gap-0 lg:pb-2" style="--i:3" aria-label={s.home.researchTitle}>
        <span class="mono-label border-b border-[#22302D] pb-3 text-[#7E8E8A]">{s.home.researchTitle}</span>
        {thrusts.map((thrust, i) => (
          <a
            href={localePath('/research/', lang)}
            class="group flex items-baseline gap-4 border-b border-[#22302D] py-4 no-underline"
          >
            <span class="font-mono text-[11px] tabular-nums text-[#63D2C3]">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[15.5px] leading-snug text-[#A7B5B1] transition-colors group-hover:text-[#F3F7F5]">
              {thrust.data.title}
            </span>
          </a>
        ))}
      </nav>
     </div>

      <dl class="hero-in grid grid-cols-2 gap-px border-t border-[#22302D] bg-[#22302D] md:grid-cols-4" style="--i:4">
        {s.home.stats.map((stat) => (
          <div class="flex flex-col gap-1.5 bg-[#0B100F] px-1 pt-5 md:px-0">
            <dd class="font-display text-[clamp(28px,3.4vw,40px)] leading-none tabular-nums text-[#F3F7F5]">
              <span class="count" data-to={stat.value}>{stat.value}</span><span class="text-[0.55em] text-[#63D2C3]">{stat.unit}</span>
            </dd>
            <dt class="font-mono text-[11px] leading-snug text-[#7E8E8A]">{stat.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <StoryScroll lang={lang} />

  <div class="mx-auto max-w-[1140px] px-7 pb-24">
    <!-- Highlights: text blocks, not cards -->
    <section class="band border-t-0 pt-14" id="highlights">
      <div class="flex flex-col gap-1.5">
        <span class="mono-label">{s.home.highlightsLabel}</span>
        <h2 class="text-[21px]">{s.home.highlightsTitle}</h2>
      </div>
      <div class="flex flex-col gap-7">
        {s.home.highlights.map((h) => (
          <div class="flex max-w-[74ch] flex-col gap-1">
            <p class="font-display text-[20px] font-semibold">{h.lead}</p>
            <p class="text-[15.5px] text-ink-2" set:html={h.body} />
          </div>
        ))}
      </div>
    </section>

    <!-- Research thrusts -->
    <section class="band" id="research">
      <div class="flex flex-col gap-1.5">
        <span class="mono-label">{s.home.researchLabel}</span>
        <h2 class="text-[21px]">{s.home.researchTitle}</h2>
        <a class="link mt-1 w-fit text-[13px]" href={localePath('/research/', lang)}>{s.common.fullResearch}</a>
      </div>
      <div class="flex flex-col gap-8">
        {thrusts.map((thrust, i) => (
          <div class="flex flex-col gap-2">
            <span class="font-mono text-[11px] tracking-[0.13em] text-muted tabular-nums">
              {lang === 'ko' ? `${s.home.ordinals[i]} ${s.home.thrustWord}` : `${s.home.thrustWord} ${i + 1}`}
            </span>
            <h3 class="text-[19px]">{thrust.data.title}</h3>
            <p class="max-w-[74ch] text-[15px] text-ink-2">{thrust.body?.trim()}</p>
            <div class="flex flex-wrap gap-2 pt-1">
              {thrust.data.keywords.map((k) => <span class="chip">{k}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section class="band" id="projects">
      <div class="flex flex-col gap-1.5">
        <span class="mono-label">{s.home.projectsLabel}</span>
        <h2 class="text-[21px]">{s.home.projectsTitle}</h2>
        <a class="link mt-1 w-fit text-[13px]" href={localePath('/projects/', lang)}>{s.common.allProjects}</a>
      </div>
      <ul class="flex flex-col">
        {projects.map((p) => (
          <li class="border-t border-line first:border-t-0 first:pt-0">
            <a
              href={localePath(`/projects/${splitId(p.id).slug}/`, lang)}
              class="group grid gap-2 py-5 no-underline sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8"
            >
              <div class="flex flex-col gap-1.5">
                <h3 class:list={['text-[19px] transition-colors', p.data.accent === 'signal' ? 'group-hover:text-signal' : 'group-hover:text-accent']}>
                  {p.data.title}
                </h3>
                <p class="max-w-[70ch] text-[14.5px] text-ink-2">{p.data.oneLiner}</p>
              </div>
              <div class="flex flex-wrap gap-2">
                {p.data.tags.map((tag) => <span class="chip">{tag}</span>)}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Selected publications -->
    <section class="band" id="publications">
      <div class="flex flex-col gap-1.5">
        <span class="mono-label">{s.home.publicationsLabel}</span>
        <h2 class="text-[21px]">{s.home.publicationsTitle}</h2>
        <a class="link mt-1 w-fit text-[13px]" href={localePath('/publications/', lang)}>{s.common.allPapers}</a>
      </div>
      <ul class="flex flex-col">
        {featured.map((p) => (
          <li class="flex flex-col gap-2 border-t border-line py-5 first:border-t-0 first:pt-0">
            <div class="flex flex-wrap items-baseline gap-x-3">
              <span class="font-mono text-[12px] tabular-nums text-muted">{p.data.year}</span>
              <span class="font-mono text-[12px] italic text-ink-2">{p.data.venue}</span>
            </div>
            <h3 class="max-w-[70ch] text-[18px]" lang="en">
              <a class="link" href={`https://doi.org/${p.data.doi}`} rel="noopener" target="_blank">{p.data.title}</a>
            </h3>
            <p class="max-w-[74ch] text-[14.5px] text-ink-2">
              {lang === 'ko' ? p.data.contributionKo : p.data.contribution}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Recent -->
    <section class="band" id="recent">
      <div class="flex flex-col gap-1.5">
        <span class="mono-label">{s.home.recentLabel}</span>
        <h2 class="text-[21px]">{s.home.recentTitle}</h2>
      </div>
      <ul class="flex flex-col">
        {s.home.recent.map((r) => (
          <li class="grid gap-2 border-t border-line py-4 first:border-t-0 first:pt-0 sm:grid-cols-[120px_minmax(0,1fr)] sm:gap-6">
            <span class="font-mono text-[12px] tabular-nums text-muted">{r.when}</span>
            <p class="max-w-[70ch] text-[15px] text-ink-2" set:html={r.what} />
          </li>
        ))}
      </ul>
    </section>

    <section class="flex flex-wrap items-baseline justify-between gap-6 border-t border-line-strong pt-10">
      <p class="max-w-[46ch] font-display text-[21px]">{s.home.closing}</p>
      <a
        href={localePath('/projects/', lang)}
        class="rounded-[4px] bg-accent px-4 py-2 text-[14px] font-medium text-bg no-underline transition-colors hover:bg-accent-deep"
        >{s.common.seeProjects}</a
      >
    </section>
  </div>
</Base>

<style>
  /* Load-time entrance. Not scroll-triggered: the page is legible the moment
     it paints, and this only staggers the arrival. */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }
  .hero-in { animation: heroIn 620ms cubic-bezier(0.22, 0.8, 0.3, 1) both; animation-delay: calc(var(--i) * 90ms); }
  @media (prefers-reduced-motion: reduce) {
    .hero-in { animation: none; }
  }
</style>

<script>
  // Stat count-up. The final value is already in the HTML, so the numbers are
  // correct with JavaScript off; this only animates towards them.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('.count').forEach((el) => {
      const to = Number(el.dataset.to ?? '0');
      if (!Number.isFinite(to) || to === 0) return;
      const started = performance.now();
      const dur = 900;
      const step = (now: number) => {
        const p = Math.min(1, (now - started) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(to * eased).toLocaleString();
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  // Reading position. The only scroll effect on the page — there are no
  // scroll-triggered entrance animations by design.
  const bar = document.getElementById('scroll-progress');
  if (bar) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = max > 0 ? `${Math.min(100, (window.scrollY / max) * 100)}%` : '0%';
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
