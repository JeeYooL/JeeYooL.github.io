---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t, htmlLang, LOCALES, type Lang } from '../i18n/ui';
import { localePath, canonicalPath } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Home uses the scroll-reactive nav; inner pages keep it always open. */
  scrollNav?: boolean;
}
const { lang, title, description, scrollNav = false } = Astro.props;
const s = t(lang);

const pageTitle = title === s.name ? s.name : `${title} — ${s.name}`;
const desc = description ?? `${s.name} — ${s.tagline} ${s.intro}`;
const origin = Astro.site ?? new URL('https://jeeyool.github.io');
const canonical = new URL(Astro.url.pathname, origin).href;
const here = canonicalPath(Astro.url);
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath(here, l), origin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(here, 'ko'), origin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    {/* Pretendard carries the Korean text. The dynamic-subset build ships only
        the syllable blocks a page actually uses, so it costs far less than a
        full Korean webfont. */}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"
    />

    {/* Applies the stored theme before first paint so the page never flashes. */}
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('theme');
          if (v === 'dark' || v === 'light') document.documentElement.setAttribute('data-theme', v);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-bg text-ink" data-lang={lang}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-raised focus:px-4 focus:py-2 focus:text-accent"
      >{s.a11y.skip}</a
    >
    <Nav lang={lang} scrollNav={scrollNav} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
