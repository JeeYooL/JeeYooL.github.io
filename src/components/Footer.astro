---
import { site, href, nav } from '../data/site';
---
<footer class="border-t border-line-strong bg-surface">
  <div class="mx-auto flex max-w-[1140px] flex-wrap items-start justify-between gap-8 px-7 py-10">
    <div class="flex flex-col gap-1">
      <span class="font-display text-[16px] font-semibold">{site.name}</span>
      <span class="text-[13px] text-muted">{site.affiliationPlain}</span>
      <span class="text-[13px] text-muted">{site.location}</span>
      <a class="link mt-1 w-fit font-mono text-[12.5px]" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav class="flex flex-col gap-1" aria-label="Footer">
      {nav.map((i) => <a class="text-[13px] text-ink-2 no-underline hover:text-accent" href={href(i.href)}>{i.label}</a>)}
    </nav>
    <div class="flex flex-col gap-1 font-mono text-[11.5px] text-muted">
      <a class="no-underline hover:text-accent" href={site.links.github} rel="me noopener" target="_blank">github.com/JeeYooL</a>
      <a class="no-underline hover:text-accent" href={site.repo} rel="noopener" target="_blank">Site repository</a>
      <span>Last updated {site.lastUpdated}</span>
    </div>
  </div>
</footer>
