---
/**
 * Hero figure: normalized PCE against time under continuous MPPT.
 *
 * The curve is generated at build time from a three-exponential degradation
 * model — burn-in, light-soaking recovery, and two decay terms:
 *
 *   y(t) = 1 − 0.065(1−e^(−t/9)) + 0.022(1−e^(−t/70))
 *            − 0.055(1−e^(−t/320)) − 0.20(1−e^(−t/2400))
 *
 * TO REPLACE WITH MEASURED DATA: drop a two-column CSV (hours, normalized PCE)
 * at src/data/mppt.csv, read it here instead of calling `model()`, and edit the
 * caption below — it currently declares the trace synthetic, which it must
 * while this model is what draws it.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const T_MAX = 2000;
const X0 = 70, X1 = 980, Y_TOP = 40; // y=40 is PCE 1.00; 1000 SVG units per 1.0 PCE
const model = (t: number) =>
  1 - 0.065 * (1 - Math.exp(-t / 9))
    + 0.022 * (1 - Math.exp(-t / 70))
    - 0.055 * (1 - Math.exp(-t / 320))
    - 0.20 * (1 - Math.exp(-t / 2400));

const px = (t: number) => X0 + (t / T_MAX) * (X1 - X0);
const py = (pce: number) => Y_TOP + (1 - pce) * 1000;

const samples = Array.from({ length: 401 }, (_, i) => (i / 400) * T_MAX);
const points = samples.map((t) => [px(t), py(model(t))] as const);
const d = points.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(2)} ${y.toFixed(2)}`).join(' ');

// Stroke length, so the draw-on animation runs exactly once end to end.
const traceLen = Math.ceil(
  points.reduce((sum, p, i) => (i === 0 ? 0 : sum + Math.hypot(p[0] - points[i - 1]![0], p[1] - points[i - 1]![1])), 0),
);

// T80: first crossing of 0.80 normalized PCE.
let t80 = T_MAX;
for (let lo = 0, hi = T_MAX, i = 0; i < 60; i++) {
  const mid = (lo + hi) / 2;
  if (model(mid) > 0.8) lo = mid; else hi = mid;
  t80 = lo;
}
const t80x = px(t80);

const yTicks = [1.0, 0.95, 0.9, 0.85, 0.8];
const xTicks = [0, 500, 1000, 1500, 2000];
---
<figure class="flex flex-col gap-3">
  <svg
    viewBox="0 0 1000 300"
    class="w-full"
    role="img"
    aria-label={`Modelled degradation trace: normalized power conversion efficiency falling from 1.00 to about ${model(T_MAX).toFixed(2)} over ${T_MAX} hours of continuous maximum-power-point tracking, crossing 0.80 at roughly ${Math.round(t80)} hours.`}
  >
    <!-- horizontal gridlines, one per labelled value -->
    {yTicks.map((v) => (
      <line x1={X0} y1={py(v)} x2={X1} y2={py(v)} stroke="var(--c-line)" stroke-width="1" />
    ))}
    {yTicks.map((v) => (
      <text x={X0 - 12} y={py(v) + 4} text-anchor="end" font-family="var(--font-mono)" font-size="12" fill="var(--c-muted)">
        {v.toFixed(2)}
      </text>
    ))}
    {xTicks.map((t) => (
      <text x={px(t)} y="272" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--c-muted)">
        {t}
      </text>
    ))}
    <line x1={X0} y1="248" x2={X1} y2="248" stroke="var(--c-line-strong)" stroke-width="1" />

    <text x={X0 - 12} y="20" text-anchor="start" font-family="var(--font-mono)" font-size="12" fill="var(--c-muted)">
      Normalized PCE
    </text>
    <text x={X1} y="294" text-anchor="end" font-family="var(--font-mono)" font-size="12" fill="var(--c-muted)">
      Time under continuous MPPT (h)
    </text>

    <!-- T80 annotation: the one place the signal colour is allowed -->
    <g class="trace-late">
      <line x1={t80x} y1={py(0.8)} x2={t80x} y2="248" stroke="var(--c-signal)" stroke-width="1" stroke-dasharray="3 3" />
      <circle cx={t80x} cy={py(0.8)} r="4" fill="var(--c-signal)" />
      <text x={t80x - 10} y={py(0.8) - 10} text-anchor="end" font-family="var(--font-mono)" font-size="13" fill="var(--c-signal)">
        T80 ≈ {Math.round(t80)} h
      </text>
    </g>

    <path
      class="trace"
      style={`--trace-len:${traceLen}`}
      d={d}
      fill="none"
      stroke="var(--c-accent)"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {!compact && (
    <figcaption class="font-mono text-[11px] leading-relaxed text-muted">
      Synthetic trace from a three-exponential degradation model — burn-in, light-soaking
      recovery, and two decay terms. Not measured data; it stands in until a measured MPPT
      run replaces it.
    </figcaption>
  )}
</figure>
