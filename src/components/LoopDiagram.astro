---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<div class="flex flex-col gap-4">
  <ol class="grid grid-cols-1 gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
    {s.research.stages.map((stage, i) => (
      <li class="flex flex-col gap-1.5 bg-bg p-5">
        <span class="font-mono text-[11px] tracking-[0.13em] text-accent">{s.research.stageWord} {i + 1}</span>
        <span class="font-display text-[19px] font-semibold">{stage.label}</span>
        <span class="text-[13px] leading-snug text-muted">{stage.note}</span>
      </li>
    ))}
  </ol>
  <p class="font-mono text-[11px] leading-relaxed text-muted">{s.research.loopCaption}</p>
</div>
